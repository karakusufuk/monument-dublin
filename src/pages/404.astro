---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found — Monument" description="This page has moved, or never existed.">
  <section class="wrap banner" style="padding-bottom:var(--section)">
    <h1 style="max-width:900px">This page has moved, or never existed.</h1>
    <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:40px">
      <a href="/" class="btn btn-lg">Back to home</a>
      <a href="/properties/" class="btn btn-ghost btn-lg">See properties</a>
    </div>
  </section>
</Base>
