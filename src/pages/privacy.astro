---
import Base from '../layouts/Base.astro';
---
<Base title="Privacy — Monument" description="Monument is a fictional concept agency. This site stores no data and uses no cookies or analytics.">
  <section class="wrap banner" style="padding-bottom:var(--section)">
    <p class="eyebrow">Legal</p><h1>Privacy.</h1>
    <div class="body" style="margin-top:40px;display:grid;gap:20px">
      <p>Monument is a fictional estate agency created as a portfolio concept by Ufuk Karakuş. Listings, prices and people are invented. Forms on this site do not send or store your details anywhere. No cookies or analytics are used.</p>
      <p>The map tiles on this site are loaded from OpenFreeMap when a map comes into view. That request shares your IP address with that service, as any web request does.</p>
    </div>
  </section>
</Base>
