---
import Base from '../layouts/Base.astro';
---
<Base title="Terms — Monument" description="Terms of use for the Monument concept site.">
  <section class="wrap banner" style="padding-bottom:var(--section)">
    <p class="eyebrow">Legal</p><h1>Terms.</h1>
    <div class="body" style="margin-top:40px;display:grid;gap:20px">
      <p>Monument is a fictional estate agency created as a portfolio concept by Ufuk Karakuş. Nothing on this site is an offer to buy, sell or let a property.</p>
      <ol style="list-style:decimal;padding-left:22px;display:grid;gap:12px">
        <li>Listings, prices, photographs and people are invented for demonstration only.</li>
        <li>Forms are a demonstration. They check your entries and show a result, but nothing is sent, stored or answered.</li>
        <li>Design and code belong to their author. Please ask before reusing them.</li>
      </ol>
    </div>
  </section>
</Base>
