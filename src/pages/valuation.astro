---
import Base from '../layouts/Base.astro';
import { areas } from '../lib/data';
const types = ['Terraced house', 'Semi-detached', 'Detached', 'Apartment', 'Cottage or mews', 'Other'];
const beds = ['1', '2', '3', '4', '5 or more'];
const plans = ['Selling', 'Letting', 'Not sure yet', 'Just curious about value'];
const opt = (list: string[], key: string) => list.map((t) => ({ t, key }));
---
<Base title="Get an offer — free home valuation — Monument" description="Request a free valuation of your Dublin home in about two minutes. Someone who sells in your area will call within 48 hours." bare slimFooter>
  <header class="vhdr">
    <a href="/" class="logo" aria-label="Monument, home">monument</a>
    <span class="vmid">Free valuation · about 2 minutes</span>
    <a href="/" class="btn btn-ghost" id="vclose">Close</a>
  </header>

  <div class="vwrap" id="vwrap">
    <div class="vmain">
      <form id="vform" novalidate>
        <div class="vprog"><p class="eyebrow" id="vstep" aria-live="polite">Step 1 of 5</p><div class="vbar"><i id="vfill"></i></div></div>

        <section class="vs" data-step="1">
          <h1 class="vh">Where is your home?</h1>
          <div class="field"><label for="va">Street address</label><input id="va" class="input" autocomplete="street-address" aria-describedby="e-va" /><span class="err" id="e-va" aria-live="polite"></span></div>
          <div class="field"><label for="vr">Area</label>
            <select id="vr" class="input" aria-describedby="e-vr"><option value="">Choose an area</option>{areas.map((a) => <option value={a.slug}>{a.name}</option>)}<option value="elsewhere">Elsewhere in Dublin</option></select>
            <span class="err" id="e-vr" aria-live="polite"></span></div>
          <div class="field"><label for="vc">Eircode (optional)</label><input id="vc" class="input" autocomplete="postal-code" aria-describedby="e-vc" /><span class="err" id="e-vc" aria-live="polite"></span></div>
        </section>

        {[[2, 'What kind of home is it?', types, 'type'], [3, 'How many bedrooms?', beds, 'beds'], [4, 'Are you thinking of selling or letting?', plans, 'plan']].map(([n, q, list, key]) => (
          <section class="vs" data-step={n} hidden>
            <h2 class="vh">{q}</h2>
            <div class="vopts" role="radiogroup" aria-label={q as string}>
              {(list as string[]).map((t) => <button type="button" class="vopt" role="radio" aria-checked="false" data-key={key} data-v={t}><span>{t}</span></button>)}
            </div>
          </section>
        ))}

        <section class="vs" data-step="5" hidden>
          <h2 class="vh">How can we reach you?</h2>
          <div class="field"><label for="vn">Name</label><input id="vn" class="input" autocomplete="name" aria-describedby="e-vn" /><span class="err" id="e-vn" aria-live="polite"></span></div>
          <div class="field"><label for="vp">Phone</label><input id="vp" class="input" type="tel" autocomplete="tel" aria-describedby="e-vp" /><span class="err" id="e-vp" aria-live="polite"></span></div>
          <div class="field"><label for="ve">Email</label><input id="ve" class="input" type="email" autocomplete="email" aria-describedby="e-ve" /><span class="err" id="e-ve" aria-live="polite"></span></div>
        </section>

        <div class="vnav">
          <button type="button" class="btn btn-ghost btn-lg" id="vback" hidden>Back</button>
          <button type="submit" class="btn btn-lg" id="vnext">Continue</button>
        </div>
      </form>

      <section id="vdone" hidden>
        <p class="eyebrow">Request received</p>
        <h1 class="vh" style="font-size:clamp(44px,5.6vw,72px);margin-top:16px">Thank you.<br />We'll call within 48 hours.</h1>
        <p class="lead" id="vdone-t" style="margin-top:28px;max-width:560px"></p>
        <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:36px">
          <a class="btn btn-lg" id="vdone-a" href="/areas/">See our areas</a>
          <a class="btn btn-ghost btn-lg" href="/">Back to home</a>
        </div>
      </section>
    </div>

    <aside class="vsum" id="vsum">
      <div class="vbox">
        <h2 style="font:600 17px/1.2 var(--font-body)">Your home</h2>
        <dl>
          <div><dt>Address</dt><dd id="s-addr">—</dd></div>
          <div><dt>Type</dt><dd id="s-type">—</dd></div>
          <div><dt>Bedrooms</dt><dd id="s-beds">—</dd></div>
          <div><dt>Plan</dt><dd id="s-plan">—</dd></div>
        </dl>
      </div>
      <p class="meta" style="margin-top:16px">Free and without obligation. A valuation is an estimate based on a visit, not an online figure.</p>
    </aside>
  </div>
  <script type="application/json" id="vareas" set:html={JSON.stringify(areas.map((a) => ({ slug: a.slug, name: a.name })))}></script>
  <script>import '../scripts/valuation';</script>
</Base>

<style is:global>
.vhdr{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:20px 40px;max-width:var(--max);margin:0 auto}
.vmid{font-size:15px;color:var(--text-3)}
.vwrap{max-width:1180px;margin:0 auto;padding:64px 40px 140px;display:grid;grid-template-columns:7fr 4fr;gap:80px;align-items:start}
.vprog{display:flex;align-items:center;gap:20px;margin-bottom:28px}
.vbar{width:240px;height:3px;background:var(--line)}
.vbar i{display:block;height:100%;background:var(--ink);width:20%;transition:width 200ms}
.vh{font:400 clamp(40px,4.5vw,64px)/1.05 var(--font-display);margin-bottom:36px}
.vs{transition:opacity 200ms}
.vs[hidden]{display:none}
.vopts{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.vopt{display:flex;align-items:center;justify-content:space-between;min-height:64px;padding:0 22px;border:1px solid var(--line-strong);border-radius:16px;background:#fff;font:600 16px/1.2 var(--font-body);text-align:left}
.vopt[aria-checked=true]{background:var(--ink);color:#fff;border-color:var(--ink)}
.vopt[aria-checked=true]::after{content:'✓'}
.vnav{display:flex;gap:12px;margin-top:40px}
.vbox{border:1px solid var(--line);border-radius:24px;padding:28px}
.vbox dl{margin:16px 0 0}
.vbox dl>div{display:flex;justify-content:space-between;gap:16px;padding:12px 0;border-top:1px solid var(--line)}
.vbox dt{color:var(--text-3);font-size:15px}
.vbox dd{margin:0;font-weight:600;font-size:15px;text-align:right}
@media (max-width:768px){
  .vhdr{padding:14px 20px}
  .vmid{display:none}
  .vwrap{grid-template-columns:1fr;padding:32px 20px 160px;gap:40px}
  .vbar{width:100%;flex:1}
  .vopts{grid-template-columns:1fr}
  .vnav{position:fixed;left:0;right:0;bottom:0;z-index:60;background:#fff;border-top:1px solid var(--line);margin:0;padding:12px 16px}
  .vnav .btn{flex:1}
  .vsum .vbox{padding:20px}
}
</style>
