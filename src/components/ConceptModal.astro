---
import { CASE_STUDY_URL } from '../config/site';
---
<div class="cpt" id="cpt" hidden>
  <div class="cpt-scrim"></div>
  <div class="cpt-panel" role="dialog" aria-modal="true" aria-labelledby="cpt-title" aria-describedby="cpt-body">
    <p class="eyebrow">Concept site</p>
    <h2 id="cpt-title">Concept site by Ufuk Karakuş</h2>
    <p id="cpt-body"></p>
    <div class="cpt-actions">
      <a class="btn" href={CASE_STUDY_URL} target="_blank" rel="noopener">See how it works →</a>
      <button type="button" class="btn btn-ghost" id="cpt-close">Close</button>
    </div>
  </div>
</div>
<script>import '../scripts/concept';</script>
<style is:global>
.cpt{position:fixed;inset:0;z-index:200;display:flex;align-items:flex-end;justify-content:center}
.cpt[hidden]{display:none}
.cpt-scrim{position:absolute;inset:0;background:rgba(14,14,14,.5);opacity:0;transition:opacity var(--t-base) var(--ease)}
.cpt-panel{position:relative;background:#fff;color:var(--ink);width:100%;max-width:520px;padding:32px 24px calc(28px + env(safe-area-inset-bottom));border-radius:var(--radius-card) var(--radius-card) 0 0;transform:translateY(100%);transition:transform var(--t-base) var(--ease)}
.cpt.show .cpt-scrim{opacity:1}
.cpt.show .cpt-panel{transform:none}
.cpt-panel .eyebrow{margin:0 0 14px}
.cpt-panel h2{font:400 clamp(30px,5vw,40px)/1.1 var(--font-display);margin:0}
.cpt-panel #cpt-body{margin:16px 0 0;font:400 var(--fs-body)/1.6 var(--font-body);color:var(--text-2)}
.cpt-actions{display:flex;flex-direction:column;gap:10px;margin-top:28px}
.cpt-actions .btn{width:100%}
@media (min-width:768px){
  .cpt{align-items:center;padding:24px}
  .cpt-panel{border-radius:var(--radius-card);padding:40px;transform:translateY(16px);opacity:0;transition:transform var(--t-base) var(--ease),opacity var(--t-base) var(--ease)}
  .cpt.show .cpt-panel{opacity:1;transform:none}
  .cpt-actions{flex-direction:row}
  .cpt-actions .btn{width:auto}
}
@media (prefers-reduced-motion:reduce){.cpt-scrim,.cpt-panel{transition:none}}
</style>
