---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConceptModal from '../components/ConceptModal.astro';
import { photo } from '../lib/photos';
interface Props { title: string; description: string; ogPhoto?: string; home?: boolean; bare?: boolean; slimFooter?: boolean; bodyClass?: string }
const { title, description, ogPhoto = 'HERO.webp', home = false, bare = false, slimFooter = false, bodyClass } = Astro.props;
const og = await getImage({ src: photo(ogPhoto), width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogUrl = new URL(og.src, Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} />
  <meta property="og:type" content="website" /><meta property="og:url" content={canonical} /><meta property="og:image" content={ogUrl} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <script is:inline>document.documentElement.classList.add('js')</script>
  <slot name="head" />
  <meta name="robots" content="noindex, nofollow" />
</head>
<body class={bodyClass}>
  <a class="skip" href="#main">Skip to content</a>
  {!bare && <Header home={home} />}
  <slot name="top" />
  <main id="main" tabindex="-1"><slot /></main>
  <Footer slim={slimFooter} />
  <ConceptModal />
  <script>import '../scripts/common';</script>
</body>
</html>
